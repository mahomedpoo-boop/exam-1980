function pickExamType(type){
  examType = type;
  document.querySelectorAll('#examTypeRow .pill').forEach(p=>p.classList.toggle('active', p.dataset.type===type));
  document.getElementById('catPickWrap').classList.toggle('hidden', type!=='cat');
  const countInp = document.getElementById('examCount');
  const hint = document.getElementById('examCountHint');
  if(type==='full'){
    countInp.value = Math.min(45, allItemsFlat().length);
    hint.textContent = 'امتحان شامل يغطي أسئلة من كل الأقسام بالتساوي';
  } else if(type==='random'){
    countInp.value = 15;
    hint.textContent = 'أسئلة عشوائية من كل الأصناف المتاحة';
  } else {
    countInp.value = 10;
    hint.textContent = 'أسئلة من القسم المختار فقط';
  }
}

/* Pick N items for the exam. Each item becomes one question showing ALL its
   ingredients with the quantity field left blank for the employee to fill in. */
function buildQuestions(n, catFilter){
  const pool = allItemsFlat(catFilter).filter(f=> f.item.ingredients && f.item.ingredients.length);
  if(!pool.length) return [];

  let sourceItems;
  if(examType==='full' && !catFilter){
    const byCat = {};
    pool.forEach(f=>{ (byCat[f.cat]=byCat[f.cat]||[]).push(f); });
    const cats = Object.keys(byCat);
    sourceItems = [];
    let i=0;
    while(sourceItems.length < n && sourceItems.length < pool.length){
      const cat = cats[i % cats.length];
      const arr = byCat[cat];
      if(arr && arr.length){ sourceItems.push(arr.splice(Math.floor(Math.random()*arr.length),1)[0]); }
      i++;
      if(i > n*10) break;
    }
  } else {
    const shuffled = [...pool].sort(()=>Math.random()-0.5);
    sourceItems = shuffled.slice(0, n);
  }

  return sourceItems.map(f=>({
    cat: f.cat, item: f.item,
    answers: f.item.ingredients.map(()=>null), // user inputs per ingredient row
    checked: false
  }));
}

/* extract the leading numeric value from a quantity string, e.g. "1/2 من 3" -> "1", "70" -> "70" */
function extractNumber(str){
  if(str===undefined || str===null) return null;
  const m = String(str).match(/\d+(\.\d+)?/);
  return m ? m[0] : null;
}
function answersMatch(userVal, correctVal){
  const un = extractNumber(userVal);
  const cn = extractNumber(correctVal);
  if(cn===null) return String(userVal||'').trim() === String(correctVal||'').trim();
  if(un===null) return false;
  return parseFloat(un) === parseFloat(cn);
}

let examSession = null; // {employee, typeLabel, questions, currentIdx, correctBlanks, totalBlanks}

function startExam(){
  if(!resolvedEmployee){ alert('من فضلك اكتب كود مسجل صحيح'); return; }
  const empName = resolvedEmployee.name;
  const empBranch = resolvedEmployee.branch;
  const empCode = resolvedEmployee.code;

  let n = parseInt(document.getElementById('examCount').value) || 10;
  const catFilter = examType==='cat' ? document.getElementById('examCatSelect').value : null;

  const questions = buildQuestions(n, catFilter);
  if(!questions.length){ alert('لا يوجد أصناف كافية لعمل الامتحان'); return; }

  examSession = {
    empName, empBranch, empCode,
    typeLabel: examType==='full' ? 'امتحان شامل (كل الأقسام)' : examType==='random' ? 'امتحان عشوائي' : `امتحان قسم: ${CAT_NAMES_AR[catFilter]||catFilter}`,
    questions,
    currentIdx: 0,
    correctBlanks: 0,
    totalBlanks: 0,
    startedAt: new Date()
  };
  showScreen('screen-exam');
  renderExamQuestion();
}

function renderExamQuestion(){
  const s = examSession;
  const q = s.questions[s.currentIdx];
  document.getElementById('examProgress').textContent = `صنف ${s.currentIdx+1} من ${s.questions.length}`;
  const card = document.getElementById('examCard');

  const rows = q.item.ingredients.map(([qty,unit,name],i)=>`
    <tr id="qrow${i}">
      <td style="width:90px"><input class="inp" style="padding:6px 8px;font-size:14px" type="text" inputmode="decimal"
        id="qin${i}" placeholder="؟" ${q.checked?'disabled':''} value="${q.answers[i]!==null?q.answers[i]:''}"/></td>
      <td>${unit}</td>
      <td>${name}</td>
    </tr>`).join('');

  card.innerHTML = `
    <div class="examq">اكتب الكمية (الأرقام فقط) لكل مكون من مكونات صنف "<span style="color:#e94560">${q.item.name_en}</span>" (${q.item.name_ar}) — ${CAT_NAMES_AR[q.cat]||q.cat}</div>
    <table><thead><tr><th>الكمية</th><th>الوحدة</th><th>المكون</th></tr></thead>
      <tbody>${rows}</tbody></table>
    <div style="margin-top:14px" id="nextWrap">
      ${q.checked ? '' : '<button class="btn g" style="width:100%" onclick="checkQuestion()">تحقق من الإجابات</button>'}
    </div>
  `;
  if(q.checked) showNextButton();
}

function checkQuestion(){
  const s = examSession;
  const q = s.questions[s.currentIdx];
  if(q.checked) return;
  q.checked = true;

  q.item.ingredients.forEach(([qty],i)=>{
    const val = document.getElementById('qin'+i).value;
    q.answers[i] = val;
    const rowOk = answersMatch(val, qty);
    document.getElementById('qin'+i).disabled = true;
    // ملحوظة: مفيش إظهار للصح/الغلط هنا خالص - الإجابات بتتسجل بس وتتقفل، والتصحيح بيظهر بعدين بالباسورد فقط
    s.totalBlanks++;
    if(rowOk) s.correctBlanks++;
  });
  document.getElementById('nextWrap').insertAdjacentHTML('afterbegin', '<div class="sub" style="margin-bottom:8px">✅ تم تسجيل إجاباتك لهذا الصنف</div>');
  showNextButton();
}

function showNextButton(){
  const s = examSession;
  const isLast = s.currentIdx === s.questions.length-1;
  document.getElementById('nextWrap').innerHTML =
    `<button class="btn r" style="width:100%" onclick="${isLast?'finishExam()':'nextQuestion()'}">${isLast?'إنهاء الامتحان وعرض النتيجة':'الصنف التالي'}</button>`;
}
function nextQuestion(){
  examSession.currentIdx++;
  renderExamQuestion();
}

function finishExam(){
  const s = examSession;
  const total = s.totalBlanks;
  const score = s.correctBlanks;
  const pct = total ? Math.round((score/total)*100) : 0;
  const passed = pct >= 70;
  const certNumber = genCertNumber();

  const history = JSON.parse(localStorage.getItem('kitchen1980_exam_history')||'[]');
  history.unshift({name:s.empName, branch:s.empBranch, code:s.empCode, type:s.typeLabel, score, total, pct, passed, certNumber, date: new Date().toISOString()});
  localStorage.setItem('kitchen1980_exam_history', JSON.stringify(history.slice(0,200)));

  const dateStr = new Date().toLocaleDateString('ar-EG', {year:'numeric', month:'long', day:'numeric'});
  const c = CERT_CONFIG;

  document.getElementById('certCard').innerHTML = `
    <span class="cert-leaf tl">🌿</span><span class="cert-leaf tr">🌿</span>
    <span class="cert-leaf bl">🌿</span><span class="cert-leaf br">🌿</span>

    <div class="cert-logo">🍽️ 1980 🍽️</div>
    <div class="cert-sub">${passed ? '— شهادة إتمام — CERTIFICAT DE RÉUSSITE' : '— نتيجة الامتحان —'}</div>
    <div class="cert-title">${c.titleEn} · ${c.titleAr}</div>
    <div class="cert-hr"></div>

    <div class="cert-label">يشهد بأن</div>
    <div class="cert-name">${s.empName}</div>
    <div class="cert-hr2"></div>

    <div class="cert-line">${passed ? 'قد أتم بنجاح امتحان' : 'قد خاض امتحان'}</div>
    <div class="cert-examname">${c.examName}</div>
    <div class="cert-level">⭐ ${c.level}</div>
    <div class="cert-branch">الفرع: ${s.empBranch} &nbsp;|&nbsp; الكود: ${s.empCode}</div>

    <div class="cert-badge">النتيجة: ${pct}% | إجابات صحيحة: ${score}/${total}</div>

    <div class="cert-sig-wrap">
      <div class="cert-sig">
        <div class="cert-sig-label">توقيع</div>
        <div class="cert-sig-en">${c.sig1En}</div>
        <div class="cert-sig-ar">${c.sig1Ar}</div>
      </div>
      <div class="cert-sig">
        <div class="cert-sig-label">توقيع</div>
        <div class="cert-sig-en">${c.sig2En}</div>
        <div class="cert-sig-ar">${c.sig2Ar}</div>
      </div>
    </div>

    <div class="cert-footer">
      <span>رقم الشهادة: ${certNumber}</span>
      <span>التاريخ: ${dateStr}</span>
    </div>
  `;

  document.getElementById('certReview').innerHTML = `
    <div class="card" style="text-align:center">
      <div class="sub" style="margin-bottom:10px">تفاصيل الإجابات (صح/غلط) متاحة للمسؤول فقط</div>
      <button class="btn d" onclick="requestReviewUnlock()">🔒 عرض تفاصيل الإجابات</button>
    </div>
  `;

  showScreen('screen-cert');
}

function renderCertReview(s){
  if(!s) return;
  document.getElementById('certReview').innerHTML = s.questions.map((q,i)=>{
    const rows = q.item.ingredients.map(([qty,unit,name],ri)=>{
      const ok = answersMatch(q.answers[ri], qty);
      return `<div style="font-size:11px;color:#aaa;margin-top:3px">${name}: إجابته "${q.answers[ri]||'—'}" ${ok?'✅':'❌ (الصح: '+qty+' '+unit+')'}</div>`;
    }).join('');
    return `<div class="cd">
      <div style="font-size:12px;font-weight:700;color:#e94560">${i+1}. ${q.item.name_en} — ${q.item.name_ar}</div>
      ${rows}
    </div>`;
  }).join('');
}

/* ===================== BACKUP / RESTORE ===================== */
function exportData(){
  const blob = new Blob([JSON.stringify({data:DATA, catIcons:CAT_ICONS, catNamesAr:CAT_NAMES_AR}, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'kitchen1980_backup.json';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}
function importData(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    try{
      const parsed = JSON.parse(e.target.result);
      if(!parsed.data) throw new Error('bad file');
      DATA = parsed.data;
      CAT_ICONS = Object.assign({}, DEFAULT_CAT_ICONS, parsed.catIcons||{});
      CAT_NAMES_AR = Object.assign({}, DEFAULT_CAT_NAMES_AR, parsed.catNamesAr||{});
      saveState();
      renderCatGrid();
      alert('تم الاستيراد بنجاح');
    }catch(err){
      alert('ملف غير صالح');
    }
  };
  reader.readAsText(file);
  evt.target.value = '';
}

