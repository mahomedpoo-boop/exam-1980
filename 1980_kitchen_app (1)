<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"/>
<title>1980 Kitchen Exams</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#080810;color:#fff;min-height:100vh;direction:rtl}
input,button,select,textarea{font-family:Arial,sans-serif}
.screen{display:none}.screen.active{display:block}
.btn{border:none;border-radius:10px;padding:11px 18px;font-size:13px;font-weight:800;cursor:pointer}
.btn:active{opacity:.75}
.r{background:#e94560;color:#fff}.g{background:#22c55e;color:#fff}
.d{background:#1a1a2e;color:#fff}.y{background:#ffd700;color:#000}
.gr{background:#333;color:#aaa}
.sm{padding:6px 11px;font-size:11px;border-radius:7px}
.inp{width:100%;background:#0a0a16;border:1px solid #2a2a4e;border-radius:10px;color:#fff;font-size:16px;padding:11px 14px;outline:none}
.inp:focus{border-color:#e94560}
.card{background:#0f0f1e;border:1px solid #1e1e3e;border-radius:13px;padding:14px;margin-bottom:11px}
.cd{background:#0a0a16;border:1px solid #161626;border-radius:10px;padding:11px;margin-bottom:8px}
.mb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:9999;align-items:center;justify-content:center;padding:20px;overflow-y:auto}
.mb.open{display:flex}
.mw{background:#0f0f1e;border:1px solid #e94560;border-radius:16px;padding:25px 22px;max-width:360px;width:100%;text-align:center}
table{width:100%;border-collapse:collapse}
th,td{border:1px solid #1e1e3e;padding:7px 8px}
th{background:#1a1a2e;color:#888;font-size:11px;font-weight:600}
.ok{background:rgba(34,197,94,.1)}.wx{background:rgba(239,68,68,.08)}
.sb{display:none}.sb.op{display:block}
@media(max-width:580px){.g2{grid-template-columns:1fr!important}}
@media print{.np{display:none!important}body{background:#fff!important;color:#000!important}}

/* ---- extra layout styles ---- */
.wrap{max-width:920px;margin:0 auto;padding:16px 16px 60px}
.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;gap:8px;flex-wrap:wrap}
.logo{font-size:22px;font-weight:900;color:#e94560;letter-spacing:1px}
.sub{font-size:11px;color:#888;margin-top:2px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:11px}
@media(max-width:580px){.g3{grid-template-columns:1fr 1fr!important}}
.catcard{position:relative;background:#0f0f1e;border:1px solid #1e1e3e;border-radius:13px;padding:16px 10px;text-align:center;cursor:pointer;transition:.15s}
.catcard:active{transform:scale(.96);border-color:#e94560}
.catcard.addcard{border-style:dashed;border-color:#333;color:#666}
.catname{font-weight:800;font-size:13px;margin-top:6px}
.catcount{font-size:10px;color:#888;margin-top:2px}
.itemrow{display:flex;align-items:center;justify-content:space-between;cursor:pointer}
.itemrow:active{opacity:.7}
.itemname{font-weight:800;font-size:14px}
.itemname_ar{font-size:11px;color:#888;margin-top:2px}
.backbtn{background:#1a1a2e;color:#fff;border:none;border-radius:10px;padding:9px 14px;font-size:12px;font-weight:700;cursor:pointer;margin-bottom:14px}
.stepnum{display:inline-flex;min-width:20px;height:20px;background:#e94560;border-radius:50%;align-items:center;justify-content:center;font-size:11px;font-weight:800;margin-left:8px;flex-shrink:0}
.step{display:flex;align-items:flex-start;margin-bottom:9px;font-size:13px;line-height:1.6}
.section-title{font-size:13px;color:#e94560;font-weight:800;margin:16px 0 8px}
.search{margin-bottom:14px}
.close-x{position:absolute;top:10px;left:10px;background:#1a1a2e;border:none;color:#fff;width:30px;height:30px;border-radius:8px;font-size:16px;cursor:pointer}
.mbfull .mw{max-width:560px;text-align:right;position:relative;max-height:88vh;overflow-y:auto}
.examq{font-size:14px;font-weight:700;margin-bottom:14px}
.scorebox{font-size:34px;font-weight:900;color:#e94560;margin:10px 0}
.iconbtn{background:#1a1a2e;border:1px solid #2a2a4e;color:#fff;width:30px;height:30px;border-radius:8px;font-size:13px;cursor:pointer;flex-shrink:0}
.badge{position:absolute;top:6px;left:6px;display:flex;gap:4px}
.field-label{font-size:11px;color:#888;margin:10px 0 5px;text-align:right;font-weight:700}
.ing-row{display:grid;grid-template-columns:1fr 1fr 2fr auto;gap:6px;margin-bottom:6px}
.step-row{display:flex;gap:6px;margin-bottom:6px;align-items:flex-start}
.step-row textarea{flex:1;min-height:44px;resize:vertical}
.admin-strip{display:flex;justify-content:space-between;align-items:center;background:#151527;border:1px solid #e94560;border-radius:10px;padding:8px 12px;margin-bottom:14px;font-size:12px}
.hidden{display:none!important}
.pillrow{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px}
.pill{background:#1a1a2e;border:1px solid #2a2a4e;color:#fff;border-radius:20px;padding:8px 14px;font-size:12px;cursor:pointer}
.pill.active{background:#e94560;border-color:#e94560}
.examopt{transition:.1s}

/* ---- certificate ---- */
.cert-outer{position:relative;background:#fffdf7;color:#1a1a1a;border:3px double #c8a13a;border-radius:8px;padding:34px 26px 26px;margin-bottom:16px;direction:rtl;font-family:Arial,sans-serif}
.cert-leaf{position:absolute;font-size:22px;opacity:.85}
.cert-leaf.tl{top:10px;left:14px}
.cert-leaf.tr{top:10px;right:14px}
.cert-leaf.bl{bottom:10px;left:14px}
.cert-leaf.br{bottom:10px;right:14px}
.cert-logo{font-size:26px;font-weight:900;color:#111;letter-spacing:4px;text-align:center}
.cert-sub{text-align:center;color:#c8a13a;font-size:11px;font-weight:800;letter-spacing:2px;margin:6px 0 14px;text-transform:uppercase}
.cert-title{text-align:center;font-size:21px;font-weight:900;color:#111;margin-bottom:10px}
.cert-hr{width:130px;height:2px;background:#c8a13a;margin:0 auto 16px}
.cert-label{text-align:center;color:#666;font-size:12px;margin-bottom:8px}
.cert-name{text-align:center;font-size:27px;font-weight:900;color:#1e7d32;margin-bottom:10px;line-height:1.4}
.cert-hr2{width:70%;height:1px;background:#ddd;margin:0 auto 18px}
.cert-line{text-align:center;font-size:13px;color:#444;margin-bottom:6px}
.cert-examname{text-align:center;font-size:14px;font-weight:800;color:#222;margin-bottom:10px}
.cert-level{text-align:center;font-size:13px;font-weight:700;color:#222;margin-bottom:6px}
.cert-branch{text-align:center;font-size:13px;font-weight:700;color:#222;margin-bottom:16px}
.cert-badge{display:block;width:fit-content;margin:0 auto 22px;background:#1e7d32;color:#fff;font-weight:900;font-size:14px;padding:10px 26px;border-radius:30px}
.cert-sig-wrap{display:flex;justify-content:space-around;border-top:1px solid #ddd;padding-top:16px;margin-bottom:14px;flex-wrap:wrap;gap:10px}
.cert-sig{text-align:center;flex:1;min-width:140px}
.cert-sig-label{font-size:11px;color:#888;margin-bottom:6px}
.cert-sig-en{font-size:14px;font-weight:800;color:#111}
.cert-sig-ar{font-size:12px;color:#555;margin-top:2px}
.cert-footer{display:flex;justify-content:space-between;font-size:11px;color:#777;margin-top:8px;flex-wrap:wrap;gap:6px}
</style>
</head>
<body>
<div class="wrap">

  <!-- HOME SCREEN -->
  <div class="screen active" id="screen-home">
    <div class="top">
      <div>
        <div class="logo">1980</div>
        <div class="sub">Kitchen Exams &amp; Menu Reference</div>
      </div>
      <div style="display:flex;gap:8px">
        <button class="btn r sm" onclick="openExamSetup()">📝 امتحان</button>
        <button class="btn d sm" id="adminToggleBtn" onclick="onAdminToggle()">🔒 تعديل</button>
      </div>
    </div>

    <div class="admin-strip hidden" id="adminStrip">
      <span>✅ وضع التعديل مفعّل</span>
      <div style="display:flex;gap:6px;flex-wrap:wrap">
        <button class="btn y sm" onclick="openEmployeesModal()">👥 الموظفين</button>
        <button class="btn y sm" onclick="openCertSettings()">🖋️ إعدادات الشهادة</button>
        <button class="btn y sm" onclick="exportData()">تصدير نسخة</button>
        <button class="btn gr sm" onclick="document.getElementById('importFile').click()">استيراد</button>
        <button class="btn r sm" onclick="adminLogout()">خروج</button>
      </div>
      <input type="file" id="importFile" accept="application/json" class="hidden" onchange="importData(event)"/>
    </div>

    <input class="inp search" id="searchBox" placeholder="ابحث عن صنف..." oninput="renderSearch()"/>
    <div id="searchResults"></div>

    <div class="section-title">الأقسام</div>
    <div class="g3" id="catGrid"></div>
  </div>

  <!-- CATEGORY SCREEN -->
  <div class="screen" id="screen-cat">
    <button class="backbtn" onclick="showScreen('screen-home')">→ رجوع للأقسام</button>
    <div class="top">
      <div class="logo" id="catTitle" style="font-size:18px"></div>
    </div>
    <div id="catItems"></div>
    <button class="btn g hidden" id="addItemBtn" style="width:100%;margin-top:8px" onclick="openEditItem(currentCat,-1)">+ إضافة صنف جديد</button>
  </div>

  <!-- EXAM SETUP SCREEN -->
  <div class="screen" id="screen-examsetup">
    <button class="backbtn np" onclick="showScreen('screen-home')">→ رجوع</button>
    <div class="card">
      <div class="section-title" style="margin-top:0">دخول الموظف</div>
      <input class="inp" id="examCode" placeholder="اكتب كودك" oninput="onExamCodeInput()" style="margin-bottom:10px"/>
      <div id="empInfoBox"></div>

      <div class="section-title">نوع الامتحان</div>
      <div class="pillrow" id="examTypeRow">
        <button class="pill active" data-type="full" onclick="pickExamType('full')">امتحان شامل (كل الأقسام)</button>
        <button class="pill" data-type="random" onclick="pickExamType('random')">امتحان عشوائي</button>
        <button class="pill" data-type="cat" onclick="pickExamType('cat')">امتحان قسم معين</button>
      </div>

      <div id="catPickWrap" class="hidden">
        <div class="field-label">اختر القسم</div>
        <select class="inp" id="examCatSelect" style="margin-bottom:10px"></select>
      </div>

      <div class="field-label">عدد الأسئلة</div>
      <input class="inp" id="examCount" type="number" min="3" max="90" value="15" style="margin-bottom:6px"/>
      <div class="sub" id="examCountHint" style="margin-bottom:14px"></div>

      <button class="btn r" style="width:100%" onclick="startExam()">ابدأ الامتحان</button>
    </div>
  </div>

  <!-- EXAM RUN SCREEN -->
  <div class="screen" id="screen-exam">
    <div class="top np">
      <button class="backbtn" style="margin:0" onclick="if(confirm('هل تريد الخروج من الامتحان؟ لن تُحفظ النتيجة'))showScreen('screen-home')">→ خروج</button>
      <div class="sub" id="examProgress"></div>
    </div>
    <div class="card" id="examCard"></div>
  </div>

  <!-- EXAM CERTIFICATE SCREEN -->
  <div class="screen" id="screen-cert">
    <div class="top np">
      <button class="backbtn" style="margin:0" onclick="showScreen('screen-home')">→ الرئيسية</button>
      <div style="display:flex;gap:8px">
        <button class="btn y sm" onclick="window.print()">🖨️ طباعة الشهادة</button>
        <button class="btn gr sm" onclick="openExamSetup()">امتحان جديد</button>
      </div>
    </div>
    <div class="cert-outer" id="certCard"></div>
    <div class="section-title">سجل مراجعة الإجابات</div>
    <div id="certReview"></div>
  </div>

</div>

<!-- ITEM DETAIL MODAL -->
<div class="mb mbfull" id="itemModal">
  <div class="mw">
    <button class="close-x" onclick="closeModal('itemModal')">✕</button>
    <div id="itemModalBody"></div>
  </div>
</div>

<!-- PASSWORD MODAL -->
<div class="mb" id="pwModal">
  <div class="mw">
    <button class="close-x" onclick="closeModal('pwModal')">✕</button>
    <div style="font-weight:900;font-size:16px;margin-bottom:14px">🔒 دخول وضع التعديل</div>
    <input class="inp" id="pwInput" type="password" placeholder="كلمة المرور" style="margin-bottom:12px" onkeydown="if(event.key==='Enter')checkPassword()"/>
    <div id="pwError" style="color:#e94560;font-size:11px;margin-bottom:10px"></div>
    <button class="btn r" style="width:100%" onclick="checkPassword()">دخول</button>
  </div>
</div>

<!-- EDIT CATEGORY MODAL -->
<div class="mb mbfull" id="editCatModal">
  <div class="mw">
    <button class="close-x" onclick="closeModal('editCatModal')">✕</button>
    <div style="font-weight:900;font-size:16px;margin-bottom:10px">قسم جديد</div>
    <div class="field-label">اسم القسم (إنجليزي - معرّف فريد)</div>
    <input class="inp" id="newCatKey" placeholder="مثال: Desserts"/>
    <div class="field-label">اسم القسم بالعربي</div>
    <input class="inp" id="newCatAr" placeholder="مثال: الحلويات"/>
    <div class="field-label">أيقونة (إيموجي)</div>
    <input class="inp" id="newCatIcon" placeholder="🍰" value="🍴"/>
    <button class="btn g" style="width:100%;margin-top:14px" onclick="saveNewCategory()">حفظ القسم</button>
  </div>
</div>

<!-- EDIT ITEM MODAL -->
<div class="mb mbfull" id="editItemModal">
  <div class="mw">
    <button class="close-x" onclick="closeModal('editItemModal')">✕</button>
    <div style="font-weight:900;font-size:16px;margin-bottom:10px" id="editItemTitle">تعديل صنف</div>

    <div class="field-label">اسم الصنف (إنجليزي)</div>
    <input class="inp" id="editNameEn"/>
    <div class="field-label">اسم الصنف (عربي)</div>
    <input class="inp" id="editNameAr"/>

    <div class="field-label">المكونات</div>
    <div id="ingRows"></div>
    <button class="btn gr sm" onclick="addIngRow()">+ إضافة مكون</button>

    <div class="field-label">خطوات التحضير</div>
    <div id="stepRows"></div>
    <button class="btn gr sm" onclick="addStepRow()">+ إضافة خطوة</button>

    <div style="display:flex;gap:8px;margin-top:16px">
      <button class="btn g" style="flex:1" onclick="saveEditItem()">حفظ</button>
      <button class="btn r" style="flex:1" id="deleteItemBtn" onclick="deleteCurrentItem()">حذف الصنف</button>
    </div>
  </div>
</div>

<!-- EMPLOYEES MODAL (admin) -->
<div class="mb mbfull" id="employeesModal">
  <div class="mw">
    <button class="close-x" onclick="closeModal('employeesModal')">✕</button>
    <div style="font-weight:900;font-size:16px;margin-bottom:10px" id="empFormTitle">إضافة موظف جديد</div>

    <div class="field-label">كود الموظف</div>
    <input class="inp" id="empCode" placeholder="مثال: 101"/>
    <div class="field-label">اسم الموظف</div>
    <input class="inp" id="empName" placeholder="الاسم بالكامل"/>
    <div class="field-label">الفرع</div>
    <input class="inp" id="empBranch" placeholder="اسم الفرع"/>
    <div style="display:flex;gap:8px;margin-top:12px">
      <button class="btn g" id="empSaveBtn" style="flex:1" onclick="addEmployee()">إضافة موظف</button>
      <button class="btn gr hidden" id="empCancelBtn" style="flex:1" onclick="cancelEditEmployee()">إلغاء</button>
    </div>

    <div class="field-label">أو ارفع ملف أكواد دفعة واحدة (CSV أو JSON)</div>
    <div class="sub" style="margin-bottom:8px">صيغة CSV: كود,اسم,فرع — كل موظف في سطر</div>
    <button class="btn y sm" onclick="document.getElementById('empFile').click()">📂 رفع ملف الأكواد</button>
    <input type="file" id="empFile" accept=".csv,.json,text/csv,application/json" class="hidden" onchange="importEmployeesFile(event)"/>

    <div class="field-label">لو الأكواد الافتراضية مش ظاهرة</div>
    <button class="btn d sm" onclick="restoreDefaultEmployees()">🔄 استعادة الأكواد الافتراضية الناقصة</button>

    <div class="section-title">قائمة الموظفين (<span id="empCountLabel"></span>)</div>
    <input class="inp" id="empSearchBox" placeholder="ابحث بالاسم أو الكود..." style="margin-bottom:10px" oninput="renderEmployeesList()"/>
    <div id="employeesList"></div>
  </div>
</div>

<!-- CERTIFICATE SETTINGS MODAL (admin) -->
<div class="mb mbfull" id="certSettingsModal">
  <div class="mw">
    <button class="close-x" onclick="closeModal('certSettingsModal')">✕</button>
    <div style="font-weight:900;font-size:16px;margin-bottom:10px">🖋️ إعدادات الشهادة</div>

    <div class="field-label">عنوان الشهادة (إنجليزي/فرنساوي)</div>
    <input class="inp" id="certTitleEn" placeholder="مثال: HACCP & Hygiène"/>
    <div class="field-label">عنوان الشهادة (عربي)</div>
    <input class="inp" id="certTitleAr" placeholder="مثال: سلامة الغذاء"/>
    <div class="field-label">اسم الامتحان الكامل (يظهر تحت "قد أتم بنجاح امتحان")</div>
    <input class="inp" id="certExamName" placeholder="مثال: HACCP & Hygiène · Food Safety - سلامة الغذاء"/>
    <div class="field-label">المستوى</div>
    <input class="inp" id="certLevel" placeholder="مثال: المستوى الأول"/>

    <div class="section-title">التوقيع الأول</div>
    <div class="field-label">الاسم (إنجليزي)</div>
    <input class="inp" id="sig1En" placeholder="Chef Shraby"/>
    <div class="field-label">الاسم (عربي)</div>
    <input class="inp" id="sig1Ar" placeholder="شيف شرابي"/>

    <div class="section-title">التوقيع الثاني</div>
    <div class="field-label">الاسم (إنجليزي)</div>
    <input class="inp" id="sig2En" placeholder="Chef Hassan Mohamed"/>
    <div class="field-label">الاسم (عربي)</div>
    <input class="inp" id="sig2Ar" placeholder="شيف حسن محمد"/>

    <button class="btn g" style="width:100%;margin-top:16px" onclick="saveCertSettings()">حفظ الإعدادات</button>
  </div>
</div>

