}

/* Bulk import employees from a CSV (كود,اسم,فرع per line) or JSON file [{code,name,branch}] */
function importEmployeesFile(evt){
  const file = evt.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(e){
    const text = e.target.result;
    let added = 0, skipped = 0;
    try{
      let rows = [];
      if(file.name.toLowerCase().endsWith('.json')){
        const parsed = JSON.parse(text);
        rows = Array.isArray(parsed) ? parsed.map(r=>[r.code, r.name, r.branch]) : [];
      } else {
        rows = text.split(/\r?\n/).filter(l=>l.trim()).map(line=>{
          return line.split(',').map(c=>c.trim().replace(/^"|"$/g,''));
        });
        // skip a header row if it looks like one
        if(rows.length && /كود|code/i.test(rows[0][0]||'')) rows.shift();
      }
      rows.forEach(([code,name,branch])=>{
        code=(code||'').toString().trim(); name=(name||'').toString().trim(); branch=(branch||'').toString().trim();
        if(!code || !name || !branch){ skipped++; return; }
        if(EMPLOYEES.some(e=>e.code===code)){ skipped++; return; }
        EMPLOYEES.push({code,name,branch});
        added++;
      });
      saveEmployees();
      renderEmployeesList();
      alert(`تم إضافة ${added} موظف${skipped? ' — وتم تجاهل '+skipped+' سطر ناقص/مكرر':''}`);
    }catch(err){
      alert('الملف غير صالح، تأكد من الصيغة (CSV أو JSON)');
    }
  };
  reader.readAsText(file, 'UTF-8');
  evt.target.value = '';
}

