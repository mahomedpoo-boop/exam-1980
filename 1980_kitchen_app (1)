  (DATA[cat]||[]).forEach((item, idx)=>{
    const div = document.createElement('div');
    div.className='card itemrow';
    div.innerHTML = `<div style="flex:1;cursor:pointer" onclick="openItem('${cat}',${idx})">
        <div class="itemname">${item.name_en}</div>
        <div class="itemname_ar">${item.name_ar}</div>
      </div>
      <div style="display:flex;gap:6px;align-items:center">
        ${isAdmin? `<button class="iconbtn" onclick="event.stopPropagation();openEditItem('${cat}',${idx})">✎</button>
                    <button class="iconbtn" onclick="event.stopPropagation();quickDeleteItem('${cat}',${idx})">🗑</button>`:''}
        <div style="color:#e94560;font-size:18px;cursor:pointer" onclick="openItem('${cat}',${idx})">‹</div>
      </div>`;
    wrap.appendChild(div);
  });
  document.getElementById('addItemBtn').classList.toggle('hidden', !isAdmin);
  showScreen('screen-cat');
}

function quickDeleteItem(cat, idx){
  if(!confirm('حذف هذا الصنف؟')) return;
  DATA[cat].splice(idx,1);
  saveState();
  openCat(cat);
}

/* ===================== ITEM DETAIL MODAL ===================== */
function ingredientsTable(item){
  let rows = item.ingredients.map(([q,u,n])=>
    `<tr><td>${q}</td><td>${u}</td><td>${n}</td></tr>`).join('');
  return `<table><thead><tr><th>الكمية</th><th>الوحدة</th><th>المكون</th></tr></thead>
    <tbody>${rows}</tbody></table>`;
}
function stepsList(item){
  return item.steps.map((s,i)=>
    `<div class="step"><span class="stepnum">${i+1}</span><span>${s}</span></div>`).join('');
}
function openItem(cat, idx){
  const item = DATA[cat][idx];
  const body = document.getElementById('itemModalBody');
  body.innerHTML = `
    <div style="font-weight:900;font-size:17px;color:#e94560">${item.name_en}</div>
    <div style="font-size:13px;color:#aaa;margin-bottom:4px">${item.name_ar}</div>
    <div class="sub" style="margin-bottom:12px">${CAT_NAMES_AR[cat]||cat}</div>
    <div class="section-title">المكونات</div>
    ${ingredientsTable(item)}
    <div class="section-title">طريقة الإعداد</div>
    ${stepsList(item)}
    ${isAdmin? `<button class="btn r" style="width:100%;margin-top:16px" onclick="closeModal('itemModal');openEditItem('${cat}',${idx})">✎ تعديل الصنف</button>`:''}
  `;
  openModalEl('itemModal');
}

/* ===================== EDIT ITEM (ADMIN) ===================== */
function openEditItem(cat, idx){
  if(!isAdmin){ alert('لازم تدخل وضع التعديل الأول'); return; }
  editContext = { cat, idx };
  const isNew = idx === -1;
  document.getElementById('editItemTitle').textContent = isNew ? 'إضافة صنف جديد' : 'تعديل صنف';
  document.getElementById('deleteItemBtn').classList.toggle('hidden', isNew);

  const item = isNew ? {name_en:'', name_ar:'', ingredients:[['','','']], steps:['']} : DATA[cat][idx];
  document.getElementById('editNameEn').value = item.name_en;
  document.getElementById('editNameAr').value = item.name_ar;

  const ingWrap = document.getElementById('ingRows');
  ingWrap.innerHTML = '';
  item.ingredients.forEach(row=> ingWrap.appendChild(makeIngRow(row)));

  const stepWrap = document.getElementById('stepRows');
  stepWrap.innerHTML = '';
  item.steps.forEach(s=> stepWrap.appendChild(makeStepRow(s)));

  openModalEl('editItemModal');
}
function makeIngRow(row){
  const [q,u,n] = row;
  const div = document.createElement('div');
  div.className='ing-row';
  div.innerHTML = `<input class="inp" placeholder="الكمية" value="${q||''}">
    <input class="inp" placeholder="الوحدة" value="${u||''}">
    <input class="inp" placeholder="اسم المكون" value="${n||''}">
    <button class="iconbtn" onclick="this.parentElement.remove()">✕</button>`;
  return div;
}
function makeStepRow(s){
  const div = document.createElement('div');
  div.className='step-row';
  div.innerHTML = `<textarea class="inp">${s||''}</textarea>
    <button class="iconbtn" onclick="this.parentElement.remove()">✕</button>`;
  return div;
}
function addIngRow(){ document.getElementById('ingRows').appendChild(makeIngRow(['','',''])); }
function addStepRow(){ document.getElementById('stepRows').appendChild(makeStepRow('')); }

function saveEditItem(){
  const name_en = document.getElementById('editNameEn').value.trim();
  const name_ar = document.getElementById('editNameAr').value.trim();
  if(!name_en){ alert('لازم اسم الصنف بالإنجليزي'); return; }

  const ingredients = [...document.getElementById('ingRows').children].map(row=>{
    const inputs = row.querySelectorAll('input');
    return [inputs[0].value.trim(), inputs[1].value.trim(), inputs[2].value.trim()];
  }).filter(r=> r[0]||r[1]||r[2]);

  const steps = [...document.getElementById('stepRows').children].map(row=>{
    return row.querySelector('textarea').value.trim();
  }).filter(s=>s);

  const newItem = { name_en, name_ar, ingredients, steps };
  const { cat, idx } = editContext;

  if(idx === -1){
    DATA[cat].push(newItem);
  } else {
    DATA[cat][idx] = newItem;
  }
  saveState();
  closeModal('editItemModal');
  openCat(cat);
}
function deleteCurrentItem(){
  const { cat, idx } = editContext;
  if(idx === -1) return;
  if(!confirm('حذف هذا الصنف نهائياً؟')) return;
  DATA[cat].splice(idx,1);
  saveState();
  closeModal('editItemModal');
  openCat(cat);
}

/* ===================== SEARCH ===================== */
function renderSearch(){
  const q = document.getElementById('searchBox').value.trim();
  const box = document.getElementById('searchResults');
  if(!q){ box.innerHTML=''; return; }
  let results = [];
  Object.keys(DATA).forEach(cat=>{
    DATA[cat].forEach((item, idx)=>{
      const hay = (item.name_en+' '+item.name_ar).toLowerCase();
      if(hay.includes(q.toLowerCase())) results.push({cat, idx, item});
    });
  });
  if(!results.length){ box.innerHTML = '<div class="sub">لا نتائج</div>'; return; }
  box.innerHTML = results.slice(0,20).map(r=>
    `<div class="card itemrow" onclick="openItem('${r.cat}',${r.idx})">
      <div><div class="itemname">${r.item.name_en}</div><div class="itemname_ar">${r.item.name_ar} — ${CAT_NAMES_AR[r.cat]||r.cat}</div></div>
      <div style="color:#e94560">‹</div>
    </div>`).join('');
}

/* ===================== EXAM MODE (full system) ===================== */
function allItemsFlat(catFilter){
  let flat = [];
  Object.keys(DATA).forEach(cat=>{
    if(catFilter && cat!==catFilter) return;
    (DATA[cat]||[]).forEach((item,idx)=> flat.push({cat, idx, item}));
  });
  return flat;
}

let examType = 'full';
let resolvedEmployee = null; // {name, branch, code}

function openExamSetup(){
  const sel = document.getElementById('examCatSelect');
  sel.innerHTML = Object.keys(DATA).map(cat=>
    `<option value="${cat}">${CAT_NAMES_AR[cat]||cat} (${DATA[cat].length})</option>`).join('');
  pickExamType('full');
  document.getElementById('examCode').value = '';
  document.getElementById('empInfoBox').innerHTML = '';
  resolvedEmployee = null;
  showScreen('screen-examsetup');
}

function onExamCodeInput(){
  const code = document.getElementById('examCode').value.trim();
  const infoBox = document.getElementById('empInfoBox');
  resolvedEmployee = null;
  if(!code){ infoBox.innerHTML=''; return; }

  const emp = EMPLOYEES.find(e=>e.code===code);
  if(emp){
    infoBox.innerHTML = `<div class="cd ok">مرحباً <b>${emp.name}</b> — فرع ${emp.branch} ✅</div>`;
