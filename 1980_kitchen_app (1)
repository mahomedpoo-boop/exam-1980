  if(!code || !name || !branch){ alert('اكتب الكود والاسم والفرع كلهم'); return; }

  if(editingEmployeeCode){
    // تعديل موظف موجود (ممكن يغيّر الكود نفسه كمان)
    if(code !== editingEmployeeCode && EMPLOYEES.some(e=>e.code===code)){
      alert('الكود الجديد ده مستخدم بالفعل مع موظف تاني'); return;
    }
    const idx = EMPLOYEES.findIndex(e=>e.code===editingEmployeeCode);
    if(idx > -1) EMPLOYEES[idx] = {code, name, branch};
  } else {
    if(EMPLOYEES.some(e=>e.code===code)){ alert('الكود ده مستخدم بالفعل'); return; }
    EMPLOYEES.push({code, name, branch});
